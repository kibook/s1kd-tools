\f[C]
$ DMOD=DMC\-XLINKTEST\-A\-00\-00\-00\-00A\-040A\-D_000\-01_EN\-CA.XML
$ xmllint \-\-xpath \[dq]//description/dmRef\[dq] $DMOD
